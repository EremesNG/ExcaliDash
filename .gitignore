# Dependencies
node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# Local agent skills (installed per developer; see skills-lock.json)
/.agents/skills/
/.claude/skills/

# Local CodeGraph index
/.codegraph/

# OS metadata
.DS_Store

# Generated original SPA, including copied fonts
/public/
/server/spa-html.ts
/frontend/dist/
/tests/adapter-results.json
